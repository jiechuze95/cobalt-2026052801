# cobalt API 环境变量配置
# 复制本文件为 .env 并修改为实际值：cp .env.example .env

# [必需] API 服务地址（必须包含协议和尾部斜杠）
API_URL=http://localhost:9000/

# API 监听端口（默认 9000）
API_PORT=9000

# 允许跨域请求（1=允许所有来源，0=仅同源）
CORS_WILDCARD=1

# 最大下载时长（秒，默认 10800 即 3 小时）
DURATION_LIMIT=10800

# 速率限制窗口（秒，默认 60）
RATELIMIT_WINDOW=60

# 窗口内最大请求数（默认 20）
RATELIMIT_MAX=20

# Cookies 文件路径（可选，用于需要登录的平台）
# COOKIE_PATH=./cookies.json
